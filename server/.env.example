# Copy this file to .env (same folder) and fill in what you need. .env is ignored by git: never commit it.
# Spring Boot reads it at startup (spring.config.import in application.yaml).
# With no .env at all, the dev profile uses the local MinIO and Mailpit containers from compose.yaml.
# Write values without quotes.

# ---------- Images: Cloudflare R2 ----------
# R2 overview page shows your Account ID.
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=minibasket
# R2 → Manage API tokens → Create API token, "Object Read & Write", limited to this bucket.
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# Bucket → Settings → Public access → R2.dev subdomain, without a trailing slash.
# STORAGE_PUBLIC_URL=https://pub-<ID>.r2.dev

# ---------- Email: Gmail ----------
# Google account → Security → 2-Step Verification → App passwords. Use the 16-letter app password,
# never your normal Gmail password.
# MAIL_ENABLED=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=
# MAIL_FROM=MiniBasket <you@gmail.com>

# ---------- Redis (production) ----------
# In dev, Docker Compose starts Redis for you. For a managed Redis (e.g. Upstash, Redis Cloud):
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=true

# ---------- Other ----------
# Where links in emails point (the Next.js site).
# FRONTEND_URL=http://localhost:3000
# Overrides the dev profile's JWT secret (base64, at least 32 bytes: openssl rand -base64 32).
# JWT_SECRET=
